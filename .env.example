# Copy to .env for local use. Never commit .env.

# From the Turso dashboard: Database URL, and a token from "Create Token".
# The site build only needs a read-only token; `npm run import` needs read/write.
TURSO_DATABASE_URL=libsql://quotable-math-indiramariya.aws-us-west-2.turso.io
TURSO_AUTH_TOKEN=

# Normal link to the Google Sheet, copied from the address bar while on the
# quotes tab. The sheet must be shared as "Anyone with the link: Viewer".
# A local CSV path works too, e.g. data/quotes.csv
SHEET_URL=
